# Copy this file to .env and fill in real values
# NEVER commit the real .env to GitHub

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bkbbquiz?retryWrites=true&w=majority

# JWT — CHANGE THIS to a long random secret (at least 32 chars)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRE=7d

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=BKBBQUIZ <your@gmail.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Deployed frontend URLs (update after Vercel deploy)
CLIENT_URL=https://your-client.vercel.app
ADMIN_URL=https://your-admin.vercel.app

# Admin seed credentials — CHANGE THESE before seeding
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=YourStrongPassword@123
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@yourdomain.com
